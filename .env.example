# SentinelAI local configuration
# Copy this file to .env and fill in values. Never commit .env.

# mock (default, works offline) or gemini
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SQLite database path (relative to project root unless absolute)
DATABASE_PATH=data/sentinelai.db

# Parent directory for disposable patch workspaces
WORKSPACE_ROOT=data/workspaces

# Backend URL used by the Streamlit dashboard
BACKEND_URL=http://127.0.0.1:8000

# Demo checkout service that SentinelAI watches
VICTIM_APP_URL=http://127.0.0.1:8001

# Shop health pings (disable in unit tests)
HEALTH_WATCHER_ENABLED=true
HEALTH_CHECK_INTERVAL=10
HEALTH_FAIL_THRESHOLD=3

# Pytest timeout in seconds for patch validation
PYTEST_TIMEOUT=30
RUFF_TIMEOUT=20

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Security -------------------------------------------------------------
# Named API keys, one per person/service: API_KEYS=alice=<token>,bob=<token>
# The identity written to the audit log comes from the key, never from the request body.
# Setting any key turns authentication ON for every endpoint except GET /health.
# Generate tokens with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Legacy single shared key (identity becomes "authenticated-user"); prefer API_KEYS.
SENTINEL_API_KEY=
# Force auth on/off. AUTH_ENABLED=true with no keys refuses to start (fails closed).
AUTH_ENABLED=
# Comma-separated browser origins allowed by CORS (defaults to local dev ports).
CORS_ORIGINS=
# Set false to disable /api/demo/* and /api/eval/run outside demos.
DEMO_MODE=true

# subprocess = run patch tests directly on this host (local demo only, NOT isolated)
# docker     = run them in a container: no network, read-only root fs, capped CPU/RAM/PIDs
SANDBOX_MODE=subprocess
SANDBOX_IMAGE=sentinelai-sandbox:latest

# Incidents idle in an in-progress status longer than this are reset to FAILED by the sweep
STUCK_TIMEOUT_SECONDS=300
