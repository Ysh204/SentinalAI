# SentinelAI local configuration
# Copy this file to .env and fill in values. Never commit .env.

# mock (default, works offline) or gemini
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# SQLite database path (relative to project root unless absolute)
DATABASE_PATH=data/sentinelai.db

# Parent directory for disposable patch workspaces
WORKSPACE_ROOT=data/workspaces

# Backend URL used by the Streamlit dashboard
BACKEND_URL=http://127.0.0.1:8000

# Pytest timeout in seconds for patch validation
PYTEST_TIMEOUT=30
RUFF_TIMEOUT=20

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
