# Image for SANDBOX_MODE=docker. Build once:
#   docker build -f Dockerfile.sandbox -t sentinelai-sandbox:latest .
# Only test tooling is installed: no secrets, no SentinelAI code. The workspace is bind-mounted at /work.
FROM python:3.12-slim
RUN pip install --no-cache-dir pytest ruff fastapi httpx pydantic
RUN useradd --system --no-create-home sandbox
WORKDIR /work
