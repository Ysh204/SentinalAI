# Leave empty in local dev. The UI tries the Vite proxy first, then http://127.0.0.1:8000.
# Set this only if the UI is served from a different origin than the API.
VITE_API_URL=
# Do NOT put a real API key here: VITE_* values are baked into the public JS bundle.
# The console prompts for the key at runtime and keeps it in sessionStorage only.
# VITE_API_KEY= (local dev convenience only)
